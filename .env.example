# ===========================================
# RELAY PORTFOLIO ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env.local and fill in your actual values

# Public portfolio safety mode (recommended for Vercel production)
NEXT_PUBLIC_DEMO_MODE=true

# Live-backend mode only. Leave these unset in the public Demo Mode deployment.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# NEXT_PUBLIC_PUBLIC_DEMO_URL=https://relay-portfolio-demo.vercel.app
# NEXT_PUBLIC_ACCESS_REQUEST_EMAIL=your_portfolio_contact_email@example.com
# Self-signup is intentionally unsupported. Invite users from Supabase Auth.
# Do not configure a service-role key in the public Demo Mode deployment.
# SUPABASE_SERVICE_ROLE_KEY=server_only_live_backend_key

# Optional server-only daily keepalive for a private Free Plan project
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your_server_only_publishable_key
# CRON_SECRET=generate_a_long_random_value
# NEXT_PUBLIC_GEOAPIFY_API_KEY=optional_live_backend_location_autocomplete_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Configuration (Optional - for push notifications)
# NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key_here

# Development Settings
NODE_ENV=development
