# Local owner-only administration. Copy to .env.private-beta.local and never commit it.
PRIVATE_BETA_SUPABASE_URL=https://qdagzcivuddbztsybxfk.supabase.co
PRIVATE_BETA_SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key
PRIVATE_BETA_EXPECTED_PROJECT_REF=qdagzcivuddbztsybxfk
PRIVATE_BETA_APP_URL=https://relay-private-beta.vercel.app
PRIVATE_BETA_MAX_USERS=3

# Copy the URI from the Supabase Connect dialog and replace its password
# placeholder locally. Percent-encode special characters in the password.
PRIVATE_BETA_DB_URL=postgresql://copy-the-qdag-database-connection-uri-here

# Two owner-controlled accounts in different personal workspaces, used only by
# the automated tenant-isolation test after the migrations are applied.
PRIVATE_BETA_SUPABASE_PUBLISHABLE_KEY=private_project_publishable_key
PRIVATE_BETA_TEST_USER_A_EMAIL=owner_test_a@example.com
PRIVATE_BETA_TEST_USER_A_PASSWORD=strong_unique_test_password
PRIVATE_BETA_TEST_USER_B_EMAIL=owner_test_b@example.com
PRIVATE_BETA_TEST_USER_B_PASSWORD=strong_unique_test_password
